# Copy to .env and fill in. Never commit .env.

# --- MCP server (what Unsloth Studio connects to) ------------------------------------------
# Shared secret. Unsloth Studio sends it as the header  Authorization: Bearer <token>.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me
MCP_PORT=8000
MCP_PATH=/mcp

# --- Embeddings: the `embeddings` container (llama-server) in docker-compose.yml -------------
# Name of the .gguf file you put into ./models/
EMBED_GGUF=bge-m3-q8_0.gguf
# docker-compose.yml sets EMBED_BASE_URL for the container itself. Only used if you run the
# app without Docker (python -m app.server directly on the host).
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_MODEL=embedding
EMBED_API_KEY=
# Some embedding models want prefixes (nomic-embed: "search_query: " / "search_document: ").
# bge-m3 needs none. Keep the quotes when you set them - the trailing space matters.
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# --- Qdrant (docker-compose.yml sets QDRANT_URL for the container) ---------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_docs

# --- Tools -----------------------------------------------------------------------------
TIMEZONE=Europe/Berlin
TOP_K=5
